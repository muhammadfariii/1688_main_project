modules = ["python-3.11"]

run = "uvicorn app:app --host 0.0.0.0 --port 8000"
entrypoint = "app.py"
hidden = [".git", "__pycache__", ".pytest_cache"]

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]

[userenv.production]
provider_name = "demo"
provider_api_key = "pmx_47744145266284952786bd82187618de"
demo_mode = "true"
